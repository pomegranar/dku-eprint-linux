#!/usr/bin/python3
"""Command line client for the DKU ePrint service.

Printing is `dku-eprint print`; the remaining subcommands configure the driver
and diagnose it.  `dku-eprint --help` renders HELP below, which is written out
by hand so that printing comes first and the management commands last, rather
than in argparse's flat alphabetical clump.
"""

import argparse
import os
import socket
import subprocess
import sys

# Our own directory wins, so a git checkout stays self-consistent even when an
# older copy is installed system-wide; /usr/share is the fallback for the
# installed backend, whose modules live there.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.append("/usr/share/dku-eprint")

import eprint_pharos as pharos
from eprint_config import load_config, write_config, config_path, netid_for

QUEUES = ["ePrint-Ricoh-BW", "ePrint-Ricoh-Color", "ePrint-Lexmark-BW"]
QUEUE_DESCRIPTIONS = [
    ("ePrint-Ricoh-BW",    "black & white Ricoh MP 5002"),
    ("ePrint-Ricoh-Color", "colour Ricoh MP C4503"),
    ("ePrint-Lexmark-BW",  "black & white Lexmark MS810"),
]
SIDES = ["one-sided", "two-sided-long-edge", "two-sided-short-edge"]
# Page sizes all three PPDs agree on; each Ricoh accepts fifty-odd more.
COMMON_MEDIA = ["Letter", "Legal", "A4", "A5", "A6", "B5", "Executive"]

# CUPS queue name -> (PPD filename, queue name on the print server)
QUEUE_PPDS = [
    ("ePrint-Ricoh-BW",    "RICOH Aficio MP 5002.ppd",  "ePrint-Ricoh-BW"),
    ("ePrint-Ricoh-Color", "RICOH Aficio MP C4503.ppd", "ePrint-Ricoh-Color"),
    ("ePrint-Lexmark-BW",  "MS810.ppd",                 "ePrint-Lexmark-BW"),
]
DEFAULT_PPD_DIR = "/usr/share/ppd/dku-eprint"

# Placeholders are @NAME@ rather than %s: PostScript uses % for comments, so
# %-formatting would choke on the "%!PS" header.
TEST_PAGE = b"""%!PS-Adobe-3.0
/Helvetica-Bold findfont 20 scalefont setfont
72 700 moveto (DKU ePrint - Linux driver test page) show
/Helvetica findfont 12 scalefont setfont
72 670 moveto (NetID: @NETID@) show
72 650 moveto (Host: @HOST@) show
72 630 moveto (Queue: @QUEUE@) show
72 600 moveto (If you can read this, the popup block was accepted.) show
showpage
"""


def ps_escape(text):
    """Escape a value for a PostScript literal string."""
    out = str(text)
    for char, repl in (("\\", r"\\"), ("(", r"\("), (")", r"\)")):
        out = out.replace(char, repl)
    return out.encode("ascii", "replace")


def render_test_page(netid, hostname, queue):
    page = TEST_PAGE
    for token, value in ((b"@NETID@", netid), (b"@HOST@", hostname), (b"@QUEUE@", queue)):
        page = page.replace(token, ps_escape(value))
    return page


def cmd_set_netid(args):
    cfg = load_config()
    if args.user:
        cfg.setdefault("users", {})[args.user] = args.netid
    else:
        cfg["netid"] = args.netid
    try:
        path = write_config(cfg)
    except PermissionError:
        sys.stderr.write("error: need root to write %s (try sudo)\n" % config_path())
        return 1
    print("Wrote %s" % path)
    return 0


def cmd_set_prompt(args):
    if args.mode not in ("never", "always"):
        sys.stderr.write("error: mode must be 'never' or 'always'\n")
        return 1
    cfg = load_config()
    cfg["prompt"] = args.mode
    try:
        path = write_config(cfg)
    except PermissionError:
        sys.stderr.write("error: need root to write %s (try sudo)\n" % config_path())
        return 1
    print("Wrote %s (prompt = %s)" % (path, args.mode))
    if args.mode == "always":
        print("Enable the dialog agent in your desktop session with:")
        print("  systemctl --user enable --now dku-eprint-agent.service")
    return 0


def cmd_add_queues(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    ppd_dir = args.ppd_dir or DEFAULT_PPD_DIR

    # Don't pre-check for root: CUPS also lets members of the system group
    # (wheel/lpadmin on most distros) run lpadmin. Let lpadmin decide and
    # surface whatever it actually says.
    rc = 0
    for name, ppd, remote in QUEUE_PPDS:
        path = os.path.join(ppd_dir, ppd)
        if not os.path.isfile(path):
            sys.stderr.write("warning: no PPD %s, skipping %s\n" % (path, name))
            rc = 1
            continue
        subprocess.run(["lpadmin", "-x", name],
                       capture_output=True)  # ignore "no such printer"
        proc = subprocess.run([
            "lpadmin", "-p", name, "-D", name, "-E",
            "-P", path,
            "-o", "printer-is-shared=false",
            "-o", "PageSize=Letter",
            "-v", "popup://%s/%s" % (server, remote),
        ], capture_output=True)
        if proc.returncode != 0:
            sys.stderr.write("error: %s: %s\n"
                             % (name, proc.stderr.decode().strip()))
            rc = 1
        else:
            print("  added %s" % name)
    return rc


def cmd_remove_queues(args):
    for name in QUEUES:
        proc = subprocess.run(["lpadmin", "-x", name], capture_output=True)
        if proc.returncode == 0:
            print("  removed %s" % name)
    return 0


def cmd_show(args):
    cfg = load_config()
    print("config file : %s" % config_path())
    print("server      : %s" % cfg.get("server"))
    print("netid       : %s" % (cfg.get("netid") or "(unset)"))
    print("prompt      : %s" % cfg.get("prompt", "never"))
    for user, netid in sorted((cfg.get("users") or {}).items()):
        print("  %-10s: %s" % (user, netid))
    effective = netid_for(cfg, os.environ.get("USER", ""))
    print("effective   : %s" % (effective or "(unset)"))
    return 0


def cmd_probe(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    netid = args.netid or netid_for(cfg, os.environ.get("USER", "")) or "probe"
    queues = [args.queue] if args.queue else QUEUES

    print("Probing %s as '%s'\n" % (server, netid))
    rc = 0
    for queue in queues:
        try:
            job, descriptors = pharos.query_queue(server, queue, netid, "probe")
        except (OSError, pharos.PopupError) as exc:
            print("  %-20s FAIL  %s" % (queue, exc))
            rc = 1
            continue
        print("  %-20s ok    transaction %s, server %s"
              % (queue, job["transaction"], job["netbios_name"]))
        for d in descriptors:
            print("      question: %s (%s, max %s chars)%s"
                  % (d["name"], d["type"], d["length"],
                     "  mandatory" if d["mandatory"] == "1" else ""))
            print("      prompt  : %s" % d["prompt"])
    return rc


def cmd_test_page(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    netid = args.netid or netid_for(cfg, os.environ.get("USER", ""))
    if not netid:
        sys.stderr.write("error: no NetID configured; run 'dku-eprint set-netid <netid>'\n")
        return 1
    queue = args.queue or QUEUES[0]
    hostname = cfg.get("hostname") or socket.gethostname()

    try:
        _, descriptors = pharos.query_queue(server, queue, netid, "Linux test page")
    except (OSError, pharos.PopupError) as exc:
        sys.stderr.write("error: could not reach popup server: %s\n" % exc)
        return 1
    for d in descriptors:
        d["answer"] = netid

    payload = render_test_page(netid, hostname, queue)
    block = pharos.build_popup_block(hostname, netid, "Linux test page",
                                     descriptors, application="dku-eprint")
    try:
        pharos.lpd_send(server, queue, netid, "Linux test page", block + payload,
                        hostname=hostname)
    except (OSError, pharos.PopupError) as exc:
        sys.stderr.write("error: LPD delivery failed: %s\n" % exc)
        return 1

    print("Test page sent to %s on %s as '%s'." % (queue, server, netid))
    print("Release it with your DKUCard at any ePrint station.")
    return 0


def cmd_print(args):
    """Submit files to an ePrint queue through CUPS, by way of lp(1)."""
    cfg = load_config()
    queue = args.queue or QUEUES[0]
    if queue not in QUEUES:
        sys.stderr.write("error: unknown queue %r (choose from %s)\n"
                         % (queue, ", ".join(QUEUES)))
        return 1

    files = args.files or ["-"]
    for path in files:
        if path != "-" and not os.path.isfile(path):
            sys.stderr.write("error: no such file: %s\n" % path)
            return 1

    netid = args.netid or netid_for(cfg, os.environ.get("USER", ""))
    if not netid and (cfg.get("prompt") or "never").strip().lower() != "always":
        sys.stderr.write("error: no NetID configured; run 'dku-eprint set-netid <netid>'\n")
        return 1

    cmd = ["lp", "-d", queue]
    if args.title:
        cmd += ["-t", args.title]
    if args.copies:
        cmd += ["-n", str(args.copies)]
    if args.sides:
        cmd += ["-o", "sides=%s" % args.sides]
    if args.pages:
        cmd += ["-o", "page-ranges=%s" % args.pages]
    if args.media:
        cmd += ["-o", "media=%s" % args.media]
    # The backend runs as lp and cannot see us; a job option is the only
    # channel CUPS gives us for a one-off NetID.
    if args.netid:
        cmd += ["-o", "dku-netid=%s" % args.netid]
    for opt in args.option or []:
        cmd += ["-o", opt]
    cmd += ["--"] + files

    try:
        proc = subprocess.run(cmd)
    except FileNotFoundError:
        sys.stderr.write("error: lp not found; install the CUPS client tools\n")
        return 1
    if proc.returncode != 0:
        return proc.returncode

    print("Release it with your DKUCard at any ePrint station.")
    return 0


USAGE = "dku-eprint print [OPTION...] [FILE...]\n" \
        "       dku-eprint <command> [OPTION...]"

INTRO = """dku-eprint prints from Linux to Duke Kunshan's ePrint service.

Jobs are held at the print server rather than spooled to one machine in one
room: send a job from anywhere on the campus network, then release it with your
DKUCard at any ePrint station."""

EXAMPLES = """print a file:

  dku-eprint print report.pdf

two double-sided colour copies of pages 1-4 on A4, named at the station:

  dku-eprint print --queue ePrint-Ricoh-Color --media A4 \\
                   --sides two-sided-long-edge --copies 2 --pages 1-4 \\
                   --title "Final draft" report.pdf"""

OUTRO = """`dku-eprint <command> --help` describes one command. Printing goes through
CUPS, so `lp -d ePrint-Ricoh-BW report.pdf` does the same as the first example,
and any application's print dialog works too."""


class HelpParser(argparse.ArgumentParser):
    """Top level parser that leads with printing and ends with management.

    Only the running order is ours; argparse renders every section from the
    actions themselves, so nothing drifts and the colour theme still applies.
    """

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.print_parser = None
        self.subcommands = None

    def format_help(self):
        formatter = self._get_formatter()
        formatter.add_usage(self.usage, [], [])
        formatter.add_text(INTRO)
        formatter.add_text(EXAMPLES)

        if self.print_parser is not None:
            formatter.start_section("printing options (dku-eprint print)")
            formatter.add_arguments([
                a for a in self.print_parser._actions
                if not isinstance(a, argparse._HelpAction)])
            formatter.end_section()

        if self.subcommands is not None:
            formatter.start_section(
                "setup and diagnostics (run once, or when something is wrong)")
            formatter.add_arguments([
                a for a in self.subcommands._choices_actions
                if a.dest != "print"])
            formatter.end_section()

        formatter.start_section("other options")
        formatter.add_arguments(self._optionals._group_actions)
        formatter.end_section()

        formatter.add_text(OUTRO)
        return formatter.format_help()


def main():
    ap = HelpParser(prog="dku-eprint", usage=USAGE,
                    formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--server", help="override the print server hostname")
    ap.add_argument("--netid", help="override the configured NetID")
    # Without parser_class the subparsers inherit HelpParser, and
    # `dku-eprint print --help` reprints the top level help.
    sub = ap.add_subparsers(dest="command", required=True, metavar="COMMAND",
                            parser_class=argparse.ArgumentParser)
    ap.subcommands = sub

    p = sub.add_parser(
        "print", help="send files (PDF, images, text) to an ePrint queue",
        description="Send files to an ePrint queue. Jobs are held at the "
                    "server; release them with your DKUCard at any ePrint "
                    "station.",
        epilog="examples:\n"
               "  dku-eprint print report.pdf\n"
               "  dku-eprint print --queue ePrint-Ricoh-Color --media A4 \\\n"
               "                   --sides two-sided-long-edge --copies 2 \\\n"
               "                   --pages 1-4 report.pdf\n",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("files", nargs="*", metavar="FILE",
                   help="one or more files: PDF, PostScript, images or plain "
                        "text. '-', or no file at all, reads standard input")
    p.add_argument("--queue", metavar="NAME", choices=QUEUES,
                   help="which printer: %s (default %s)"
                        % ("; ".join("%s, %s" % (name, what)
                                     for name, what in QUEUE_DESCRIPTIONS),
                           QUEUES[0]))
    p.add_argument("-n", "--copies", type=int, metavar="N",
                   help="how many copies (default 1)")
    p.add_argument("--sides", choices=SIDES, metavar="MODE",
                   help="single or double sided: %s (default %s)"
                        % (", ".join(SIDES), SIDES[0]))
    p.add_argument("--media", metavar="SIZE",
                   help="page size: %s (default Letter). The Ricohs take many "
                        "more, A3 and 11x17 among them; the Lexmark does not"
                        % ", ".join(COMMON_MEDIA))
    p.add_argument("--pages", metavar="RANGE",
                   help="print only some pages, e.g. 1-4,7")
    p.add_argument("-t", "--title", metavar="NAME",
                   help="job name shown at the release station "
                        "(default: the file name)")
    # SUPPRESS stops this clobbering a --netid given before the subcommand.
    p.add_argument("--netid", metavar="NETID", default=argparse.SUPPRESS,
                   help="charge the job to another NetID, just this once")
    p.add_argument("-o", "--option", action="append", metavar="KEY=VALUE",
                   help="any other lp(1) option, passed straight through; "
                        "repeatable. `lpoptions -p <queue> -l` lists what a "
                        "given queue accepts")
    p.set_defaults(func=cmd_print)
    ap.print_parser = p

    p = sub.add_parser("show", help="show the effective configuration")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("set-netid",
                       help="store the NetID used for every job (needs root)")
    p.add_argument("netid")
    p.add_argument("--user", help="apply to one Unix account only")
    p.set_defaults(func=cmd_set_netid)

    p = sub.add_parser("set-prompt",
                       help="'never' uses the stored NetID, 'always' asks in a "
                            "dialog for every job (needs root)")
    p.add_argument("mode", choices=["never", "always"])
    p.set_defaults(func=cmd_set_prompt)

    p = sub.add_parser("add-queues", help="create the three ePrint CUPS queues")
    p.add_argument("--ppd-dir", help="where the PPDs live (default %s)" % DEFAULT_PPD_DIR)
    p.set_defaults(func=cmd_add_queues)

    p = sub.add_parser("remove-queues", help="delete them again")
    p.set_defaults(func=cmd_remove_queues)

    p = sub.add_parser("probe", help="ask the print server what each queue requires")
    p.add_argument("--queue")
    p.set_defaults(func=cmd_probe)

    p = sub.add_parser("test-page",
                       help="send a real test page, to prove the path works")
    p.add_argument("--queue")
    p.set_defaults(func=cmd_test_page)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
