#!/usr/bin/python3
"""Admin/diagnostic CLI for the DKU ePrint Linux driver.

    dku-eprint set-netid <netid> [--user UNIX_USER]
    dku-eprint set-prompt never|always
    dku-eprint show
    dku-eprint add-queues [--ppd-dir DIR]
    dku-eprint remove-queues
    dku-eprint probe [--queue NAME]
    dku-eprint test-page [--queue NAME]
"""

import argparse
import os
import socket
import subprocess
import sys

# Our own directory wins, so a git checkout stays self-consistent even when an
# older copy is installed system-wide; /usr/share is the fallback for the
# installed backend, whose modules live there.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.append("/usr/share/dku-eprint")

import eprint_pharos as pharos
from eprint_config import load_config, write_config, config_path, netid_for

QUEUES = ["ePrint-Ricoh-BW", "ePrint-Ricoh-Color", "ePrint-Lexmark-BW"]

# CUPS queue name -> (PPD filename, queue name on the print server)
QUEUE_PPDS = [
    ("ePrint-Ricoh-BW",    "RICOH Aficio MP 5002.ppd",  "ePrint-Ricoh-BW"),
    ("ePrint-Ricoh-Color", "RICOH Aficio MP C4503.ppd", "ePrint-Ricoh-Color"),
    ("ePrint-Lexmark-BW",  "MS810.ppd",                 "ePrint-Lexmark-BW"),
]
DEFAULT_PPD_DIR = "/usr/share/ppd/dku-eprint"

# Placeholders are @NAME@ rather than %s: PostScript uses % for comments, so
# %-formatting would choke on the "%!PS" header.
TEST_PAGE = b"""%!PS-Adobe-3.0
/Helvetica-Bold findfont 20 scalefont setfont
72 700 moveto (DKU ePrint - Linux driver test page) show
/Helvetica findfont 12 scalefont setfont
72 670 moveto (NetID: @NETID@) show
72 650 moveto (Host: @HOST@) show
72 630 moveto (Queue: @QUEUE@) show
72 600 moveto (If you can read this, the popup block was accepted.) show
showpage
"""


def ps_escape(text):
    """Escape a value for a PostScript literal string."""
    out = str(text)
    for char, repl in (("\\", r"\\"), ("(", r"\("), (")", r"\)")):
        out = out.replace(char, repl)
    return out.encode("ascii", "replace")


def render_test_page(netid, hostname, queue):
    page = TEST_PAGE
    for token, value in ((b"@NETID@", netid), (b"@HOST@", hostname), (b"@QUEUE@", queue)):
        page = page.replace(token, ps_escape(value))
    return page


def cmd_set_netid(args):
    cfg = load_config()
    if args.user:
        cfg.setdefault("users", {})[args.user] = args.netid
    else:
        cfg["netid"] = args.netid
    try:
        path = write_config(cfg)
    except PermissionError:
        sys.stderr.write("error: need root to write %s (try sudo)\n" % config_path())
        return 1
    print("Wrote %s" % path)
    return 0


def cmd_set_prompt(args):
    if args.mode not in ("never", "always"):
        sys.stderr.write("error: mode must be 'never' or 'always'\n")
        return 1
    cfg = load_config()
    cfg["prompt"] = args.mode
    try:
        path = write_config(cfg)
    except PermissionError:
        sys.stderr.write("error: need root to write %s (try sudo)\n" % config_path())
        return 1
    print("Wrote %s (prompt = %s)" % (path, args.mode))
    if args.mode == "always":
        print("Enable the dialog agent in your desktop session with:")
        print("  systemctl --user enable --now dku-eprint-agent.service")
    return 0


def cmd_add_queues(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    ppd_dir = args.ppd_dir or DEFAULT_PPD_DIR
    if os.geteuid() != 0:
        sys.stderr.write("error: need root to run lpadmin (try sudo)\n")
        return 1

    rc = 0
    for name, ppd, remote in QUEUE_PPDS:
        path = os.path.join(ppd_dir, ppd)
        if not os.path.isfile(path):
            sys.stderr.write("warning: no PPD %s, skipping %s\n" % (path, name))
            rc = 1
            continue
        subprocess.run(["lpadmin", "-x", name],
                       capture_output=True)  # ignore "no such printer"
        proc = subprocess.run([
            "lpadmin", "-p", name, "-D", name, "-E",
            "-P", path,
            "-o", "printer-is-shared=false",
            "-o", "PageSize=Letter",
            "-v", "popup://%s/%s" % (server, remote),
        ], capture_output=True)
        if proc.returncode != 0:
            sys.stderr.write("error: %s: %s\n"
                             % (name, proc.stderr.decode().strip()))
            rc = 1
        else:
            print("  added %s" % name)
    return rc


def cmd_remove_queues(args):
    if os.geteuid() != 0:
        sys.stderr.write("error: need root to run lpadmin (try sudo)\n")
        return 1
    for name in QUEUES:
        proc = subprocess.run(["lpadmin", "-x", name], capture_output=True)
        if proc.returncode == 0:
            print("  removed %s" % name)
    return 0


def cmd_show(args):
    cfg = load_config()
    print("config file : %s" % config_path())
    print("server      : %s" % cfg.get("server"))
    print("netid       : %s" % (cfg.get("netid") or "(unset)"))
    print("prompt      : %s" % cfg.get("prompt", "never"))
    for user, netid in sorted((cfg.get("users") or {}).items()):
        print("  %-10s: %s" % (user, netid))
    effective = netid_for(cfg, os.environ.get("USER", ""))
    print("effective   : %s" % (effective or "(unset)"))
    return 0


def cmd_probe(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    netid = args.netid or netid_for(cfg, os.environ.get("USER", "")) or "probe"
    queues = [args.queue] if args.queue else QUEUES

    print("Probing %s as '%s'\n" % (server, netid))
    rc = 0
    for queue in queues:
        try:
            job, descriptors = pharos.query_queue(server, queue, netid, "probe")
        except (OSError, pharos.PopupError) as exc:
            print("  %-20s FAIL  %s" % (queue, exc))
            rc = 1
            continue
        print("  %-20s ok    transaction %s, server %s"
              % (queue, job["transaction"], job["netbios_name"]))
        for d in descriptors:
            print("      question: %s (%s, max %s chars)%s"
                  % (d["name"], d["type"], d["length"],
                     "  mandatory" if d["mandatory"] == "1" else ""))
            print("      prompt  : %s" % d["prompt"])
    return rc


def cmd_test_page(args):
    cfg = load_config()
    server = args.server or cfg.get("server")
    netid = args.netid or netid_for(cfg, os.environ.get("USER", ""))
    if not netid:
        sys.stderr.write("error: no NetID configured; run 'dku-eprint set-netid <netid>'\n")
        return 1
    queue = args.queue or QUEUES[0]
    hostname = cfg.get("hostname") or socket.gethostname()

    try:
        _, descriptors = pharos.query_queue(server, queue, netid, "Linux test page")
    except (OSError, pharos.PopupError) as exc:
        sys.stderr.write("error: could not reach popup server: %s\n" % exc)
        return 1
    for d in descriptors:
        d["answer"] = netid

    payload = render_test_page(netid, hostname, queue)
    block = pharos.build_popup_block(hostname, netid, "Linux test page",
                                     descriptors, application="dku-eprint")
    try:
        pharos.lpd_send(server, queue, netid, "Linux test page", block + payload,
                        hostname=hostname)
    except (OSError, pharos.PopupError) as exc:
        sys.stderr.write("error: LPD delivery failed: %s\n" % exc)
        return 1

    print("Test page sent to %s on %s as '%s'." % (queue, server, netid))
    print("Release it with your DKUCard at any ePrint station.")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="dku-eprint", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--server", help="override the print server hostname")
    ap.add_argument("--netid", help="override the configured NetID")
    sub = ap.add_subparsers(dest="command", required=True)

    p = sub.add_parser("set-netid", help="store the DKU NetID used for print jobs")
    p.add_argument("netid")
    p.add_argument("--user", help="apply to one Unix account only")
    p.set_defaults(func=cmd_set_netid)

    p = sub.add_parser("set-prompt", help="ask for the NetID every job, or never")
    p.add_argument("mode", choices=["never", "always"])
    p.set_defaults(func=cmd_set_prompt)

    p = sub.add_parser("show", help="print the effective configuration")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("add-queues", help="create the three ePrint CUPS queues")
    p.add_argument("--ppd-dir", help="where the PPDs live (default %s)" % DEFAULT_PPD_DIR)
    p.set_defaults(func=cmd_add_queues)

    p = sub.add_parser("remove-queues", help="delete the ePrint CUPS queues")
    p.set_defaults(func=cmd_remove_queues)

    p = sub.add_parser("probe", help="ask the print server what each queue requires")
    p.add_argument("--queue")
    p.set_defaults(func=cmd_probe)

    p = sub.add_parser("test-page", help="send a PostScript test page")
    p.add_argument("--queue")
    p.set_defaults(func=cmd_test_page)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
