*%========== BannerPageCommand ==============
*RICMDRIBannerPagePrintFalse RICMD: "<<
/BannerPageMode false
/MediaPosition null
/MediaType null
>>
/RDeviceProcSet 
/ProcSet findresource 
/SetBannerPage get exec"
*End
*RICMDRIBannerPagePrintTrue RICMD: "userdict /RPS_BPdict known{
<<
/BannerPageMode true
/MediaPosition userdict /RPS_BPdict get /RPS_BP_MEDIAPOSITION get
/MediaType userdict /RPS_BPdict get /RPS_BP_MEDIATYPE get
>>
/RDeviceProcSet 
/ProcSet findresource 
/SetBannerPage get exec
}if"
*End

